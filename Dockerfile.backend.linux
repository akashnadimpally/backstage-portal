# ======================================================================
# Dockerfile.backend.linux — Backstage Backend (Linux)
#
# Based on the official Backstage backend Dockerfile.
# Build context: repo root (NOT packages/backend/).
#
# Pre-build steps (run in repo root before building this image):
#   yarn install --immutable
#   yarn tsc
#   yarn build:backend
#
# Build command:
#   docker build -f Dockerfile.backend.linux --tag backstage-backend:linux .
# ======================================================================

FROM node:24-trixie-slim

# Python interpreter for node-gyp
ENV PYTHON=/usr/bin/python3
ENV NODE_ENV=production
# Required for @backstage/plugin-scaffolder-backend compatibility
ENV NODE_OPTIONS="--no-node-snapshot"

# Install native build dependencies (isolate-vm, better-sqlite3, pg)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      g++ \
      build-essential \
      libsqlite3-dev && \
    rm -rf /var/lib/apt/lists/*

# Use unprivileged node user
USER node

WORKDIR /app

# Copy Yarn configuration
COPY --chown=node:node .yarn ./.yarn
COPY --chown=node:node .yarnrc.yml backstage.json ./

# Install production workspace dependencies using the built skeleton
COPY --chown=node:node yarn.lock package.json packages/backend/dist/skeleton.tar.gz ./
RUN tar xzf skeleton.tar.gz && rm skeleton.tar.gz

RUN --mount=type=cache,target=/home/node/.cache/yarn,sharing=locked,uid=1000,gid=1000 \
    yarn workspaces focus --all --production && rm -rf "$(yarn cache clean)"

# Copy templates and examples into the image
COPY --chown=node:node examples ./examples
COPY --chown=node:node templates ./templates

# Copy the compiled backend bundle and config files
COPY --chown=node:node packages/backend/dist/bundle.tar.gz app-config*.yaml ./
RUN tar xzf bundle.tar.gz && rm bundle.tar.gz

EXPOSE 7007

CMD ["node", "packages/backend", "--config", "app-config.yaml", "--config", "app-config.production.yaml"]
