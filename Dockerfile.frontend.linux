# ======================================================================
# Dockerfile.frontend.linux — Backstage Frontend (Linux)
#
# Multi-stage build: builds the React/Webpack frontend app and
# serves the static files via an nginx container.
#
# Build context: repo root
#
# Pre-build steps (run in repo root before building):
#   yarn install --immutable
#   yarn tsc
#   yarn workspace app build
#
# Build command:
#   docker build -f Dockerfile.frontend.linux --tag backstage-frontend:linux .
#
# The app is served on port 3000 and proxies /api/* to the backend.
# ======================================================================

# Stage 1 — Build the frontend bundle inside the repo context
FROM node:24-trixie-slim AS builder

ENV PYTHON=/usr/bin/python3

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      g++ \
      build-essential && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Frontend configuration is embedded in the bundle during the build.
ARG APP_BASE_URL=http://localhost:3000
ENV APP_BASE_URL=$APP_BASE_URL

# Copy workspace configuration
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn .yarn

# Copy all package manifests so yarn can resolve workspaces
COPY packages/app/package.json packages/app/package.json
COPY packages/backend/package.json packages/backend/package.json

RUN yarn install --immutable

# Copy full source
COPY . .

# Build only the frontend workspace; the root TypeScript check also covers
# backend code and is not required to produce the frontend bundle.
RUN yarn workspace app build

# Stage 2 — Serve via nginx
FROM nginx:1.27-alpine AS runner

LABEL maintainer="backstage-skynet"

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# nginx config: serve static assets, forward /api/* to backend
COPY --from=builder /app/packages/app/dist /usr/share/nginx/html

# Custom nginx config to proxy /api to the backend
RUN printf 'server {\n\
    listen 3000;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    location / {\n\
        try_files $uri /index.html;\n\
    }\n\
\n\
    location /api/ {\n\
        proxy_pass http://backstage-backend:7007/api/;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
    }\n\
}\n' > /etc/nginx/conf.d/backstage.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
