FEATURE_COLUMNS=${{ values.featureColumns }}
TARGET_COLUMN=${{ values.targetColumn }}
TASK_TYPE=${{ values.taskType }}
MODEL_FACTORY=models:build_model
MODEL_KIND=${{ values.modelKind }}
MIN_TRAINING_ROWS=${{ values.minimumTrainingRows }}
RETRAIN_EVERY_N_LABELED=${{ values.retrainEveryRecords }}
RETRAIN_CHECK_SECONDS=15
TRAINING_WINDOW_RECORDS=50000
TEST_FRACTION=${{ values.testFraction }}
RECORDS_DB_PATH=data/records.sqlite3
MODEL_PATH=artifacts/model.joblib